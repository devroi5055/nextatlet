{
  "name": "bulletproof-react-nextjs-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test-e2e": "pm2 start \"yarn run-mock-server\" --name server && yarn playwright test",
    "prepare": "husky",
    "check-types": "tsc --project tsconfig.json --pretty --noEmit",
    "generate": "plop",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "run-mock-server": "tsx ./mock-server.ts",
    "gen:api": "npm run gen:spec && npm run gen:types",
    "gen:spec": "dotnet swagger tofile --output ./openapi/swagger.json ../NextAtlet.Api/bin/Debug/net9.0/NextAtlet.Api.dll v1",
    "gen:types": "openapi-typescript ./openapi/swagger.json -o ./src/types/api.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.23.0",
    "@hookform/resolvers": "^5.4.0",
    "@next/env": "^16.2.9",
